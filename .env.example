VITE_SPOTIFY_CLIENT_ID=
VITE_SPOTIFY_BASE_URL=                   #https://api.spotify.com/v1
VITE_SPOTIFY_AUTH_URL=                   #https://accounts.spotify.com/api/token

 #DO NOT USE LOCALHOST, THE SOPTIFY API DOES NOT ACCEPT IT
VITE_HOST=                               #127.0.0.1
VITE_PORT=                               #5173

 #Set to 'true' to run fully offline against the bundled Spotify mocks (used by E2E).
VITE_USE_SPOTIFY_MOCK=                   #false
